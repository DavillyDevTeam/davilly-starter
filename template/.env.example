# SPA — set in the environment that runs `pnpm nx run web:build`
# (Cloudflare Pages dashboard for Git integration; CI for Direct Upload).
# Unset locally so Vite proxies `/api`, `/auth`, and `/users` on the same origin.
# VITE_API_URL=https://api.example.com

# API — runtime on the Docker host. Comma-separated origins, no paths.
CORS_ORIGINS=https://example.pages.dev,https://www.example.com
# Optional. Preview URLs for this Pages project only, e.g.
# CORS_ORIGIN_REGEX=https://[a-z0-9-]+\.example\.pages\.dev
SPA_ORIGIN=https://example.pages.dev

# Postgres. Local Compose uses the `db` service instead.
DATABASE_URL=postgresql+asyncpg://app:change-me@db:5432/app

# Auth. Replace SECRET before any shared or production host.
# Email/password JWT; logout is client discard.
SECRET=change-me

# Optional. Omitted from local Compose. JWT auth does not require Redis.
# REDIS_URL=redis://redis:6379/0

# Stripe (when billing lands). Plan catalog lives in Postgres.
# STRIPE_SECRET_KEY=sk_test_change-me
# STRIPE_WEBHOOK_SECRET=whsec_change-me

# Leave unset to hide the provider. Set both the id and the secret to mount it.
# Register the redirect URI the browser actually hits:
#   local Vite proxy: http://localhost:5173/auth/google/callback
#   local Vite proxy: http://localhost:5173/auth/github/callback
#   production API:   https://<api-host>/auth/google/callback
#   production API:   https://<api-host>/auth/github/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# AUTH_CSRF_COOKIE_SECURE=true
