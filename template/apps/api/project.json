{
  "name": "api",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run uvicorn apps.api.main:app --host 0.0.0.0 --port 8000 --reload"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff check apps/api && uv run ruff format --check apps/api"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run basedpyright"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run pytest apps/api"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run python -m compileall -q apps/api"
      }
    },
    "lock": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv lock"
      }
    }
  }
}
