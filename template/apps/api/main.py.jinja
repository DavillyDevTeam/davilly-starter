from collections.abc import AsyncGenerator, Awaitable, Callable
from contextlib import asynccontextmanager

from fastapi import FastAPI, Request, Response
from fastapi.exceptions import RequestValidationError
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse
from pydantic import BaseModel
from starlette.exceptions import HTTPException as StarletteHTTPException

from apps.api.config import load_settings
from apps.api.i18n import DEFAULT_LOCALE, as_error_list, as_loc, as_tree, negotiate, t
from apps.api.migrate import migrate
from apps.api.oauth import include_oauth
from apps.api.schemas import UserCreate, UserRead, UserUpdate
from apps.api.users import build_auth

PROJECT_NAME = {{ project_name | tojson }}


class Health(BaseModel):
    status: str = "ok"


class Providers(BaseModel):
    google: bool
    github: bool


_DEFAULT_HTTP_DETAIL = {
    404: "Not Found",
    405: "Method Not Allowed",
}
_HTTP_DETAIL_KEY = {
    404: "errors.http.not_found",
    405: "errors.http.method_not_allowed",
}


def request_locale(request: Request) -> str:
    value = getattr(request.state, "locale", DEFAULT_LOCALE)
    return value if isinstance(value, str) else DEFAULT_LOCALE


def create_app() -> FastAPI:
    settings = load_settings()
    backend, fastapi_users = build_auth(settings)

    @asynccontextmanager
    async def lifespan(_app: FastAPI) -> AsyncGenerator[None]:
        await migrate(settings.database_url)
        yield

    application = FastAPI(title=PROJECT_NAME, lifespan=lifespan)
    if settings.cors_origins or settings.cors_origin_regex is not None:
        application.add_middleware(
            CORSMiddleware,
            allow_origins=list(settings.cors_origins),
            allow_origin_regex=settings.cors_origin_regex,
            allow_credentials=False,
            allow_methods=["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
            allow_headers=["Authorization", "Content-Type"],
        )

    @application.middleware("http")
    async def attach_locale(
        request: Request, call_next: Callable[[Request], Awaitable[Response]]
    ) -> Response:
        request.state.locale = negotiate(request.headers.get("accept-language"))
        response = await call_next(request)
        response.headers["Content-Language"] = request_locale(request)
        return response

    @application.exception_handler(StarletteHTTPException)
    async def http_exception_handler(
        request: Request, exc: StarletteHTTPException
    ) -> JSONResponse:
        locale = request_locale(request)
        headers = dict(exc.headers or {})
        headers["Content-Language"] = locale
        detail: object = exc.detail
        tree = as_tree(detail)
        code = None if tree is None else tree.get("code")
        if isinstance(code, str):
            return JSONResponse(
                status_code=exc.status_code,
                content={"detail": {"code": code, "message": t(code, locale)}},
                headers=headers,
            )
        if (
            isinstance(detail, str)
            and _DEFAULT_HTTP_DETAIL.get(exc.status_code) == detail
        ):
            catalog_key = _HTTP_DETAIL_KEY[exc.status_code]
            message = t(catalog_key, locale)
            if message != catalog_key:
                detail = message
        return JSONResponse(
            status_code=exc.status_code,
            content={"detail": detail},
            headers=headers,
        )

    @application.exception_handler(RequestValidationError)
    async def validation_exception_handler(
        request: Request, exc: RequestValidationError
    ) -> JSONResponse:
        locale = request_locale(request)
        details: list[dict[str, object]] = []
        raw_errors: object = exc.errors()
        for error in as_error_list(raw_errors):
            error_type = error.get("type")
            if not isinstance(error_type, str):
                continue
            interpolations = as_tree(error.get("ctx")) or {}
            catalog_key = f"errors.pydantic.{error_type}"
            message = t(catalog_key, locale, **interpolations)
            if message == catalog_key:
                raw_msg = error.get("msg")
                message = raw_msg if isinstance(raw_msg, str) else catalog_key
            details.append(
                {"type": error_type, "loc": as_loc(error.get("loc")), "msg": message}
            )
        return JSONResponse(
            status_code=422,
            content={"detail": details},
            headers={"Content-Language": locale},
        )

    application.include_router(
        fastapi_users.get_auth_router(backend),
        prefix="/auth/jwt",
        tags=["auth"],
    )
    application.include_router(
        fastapi_users.get_register_router(UserRead, UserCreate),
        prefix="/auth",
        tags=["auth"],
    )
    application.include_router(
        fastapi_users.get_users_router(UserRead, UserUpdate),
        prefix="/users",
        tags=["users"],
    )

    @application.get("/auth/providers")
    def providers() -> Providers:
        return Providers(
            google=settings.google is not None,
            github=settings.github is not None,
        )

    @application.get("/api/health")
    def health() -> Health:
        return Health()

    include_oauth(application, settings, backend, fastapi_users.get_user_manager)
    return application


app = create_app()
