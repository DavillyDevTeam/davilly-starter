import { StrictMode, useCallback, useEffect, useState } from 'react';
import { createRoot } from 'react-dom/client';
import { I18nextProvider, useTranslation } from 'react-i18next';
import {
  fetchMe,
  fetchProviders,
  login,
  logout,
  registerAccount,
  type Providers,
} from './api';
import { i18n, initI18n } from './i18n';
{% if locales | length > 1 %}
import { LanguageSwitcher } from './LanguageSwitcher';
{% endif %}
import { Account, Login, Register } from './screens';
import {
  captureHashToken,
  getAccessToken,
  oauthError,
  setAccessToken,
} from './session';
import { author, projectName } from './supportedLocales';
import './style.css';

captureHashToken();

const FEATURES: readonly string[] = ['path', 'day', 'grow'];

function Landing() {
  const { t } = useTranslation('common');
  return (
    <main>
      <section className="hero">
        <p className="eyebrow">{t('landing.eyebrow')}</p>
        <h1>{t('landing.title')}</h1>
        <p className="description">{t('landing.description')}</p>
        <a className="cta" href="#possibilities">
          {t('landing.cta')} <span>↗</span>
        </a>
        <div className="orbit" aria-hidden="true">
          <div>✦</div>
        </div>
      </section>
      <section id="possibilities" className="features">
        {FEATURES.map((feature, index) => (
          <article key={feature}>
            <span>0{index + 1}</span>
            <h2>{t(`landing.features.${feature}`)}</h2>
          </article>
        ))}
      </section>
    </main>
  );
}

function App() {
  const { t } = useTranslation('common');
  const [path, setPath] = useState(window.location.pathname);
  const [token, setToken] = useState(getAccessToken());
  const [email, setEmail] = useState<string | null>(null);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<'auth' | 'register' | 'oauth' | null>(() =>
    oauthError(window.location.search) === null ? null : 'oauth',
  );
  const [providers, setProviders] = useState<Providers>({
    google: false,
    github: false,
  });
  const go = useCallback((next: string) => {
    window.history.pushState(null, '', next);
    setPath(next);
    setError(null);
  }, []);

  useEffect(() => {
    const onPop = () => {
      setPath(window.location.pathname);
    };
    window.addEventListener('popstate', onPop);
    return () => {
      window.removeEventListener('popstate', onPop);
    };
  }, []);

  useEffect(() => {
    const controller = new AbortController();
    void fetchProviders(controller.signal).then((value) => {
      if (value !== null) setProviders(value);
    });
    return () => {
      controller.abort();
    };
  }, []);

  useEffect(() => {
    if (path === '/account' && token === null) go('/login');
  }, [path, token, go]);

  useEffect(() => {
    if (token === null || path !== '/account') return;
    const controller = new AbortController();
    void fetchMe(token, controller.signal).then((result) => {
      if (result.status === 'anonymous') {
        setAccessToken(null);
        setToken(null);
        setEmail(null);
        go('/login');
        return;
      }
      if (result.status === 'ok') setEmail(result.email);
    });
    return () => {
      controller.abort();
    };
  }, [token, path, go]);

  const message =
    error === 'auth'
      ? t('auth.failed')
      : error === 'register'
        ? t('auth.registerFailed')
        : error === 'oauth'
          ? t('auth.oauthFailed')
          : null;

  function submitLogin(nextEmail: string, password: string) {
    setBusy(true);
    void login(nextEmail, password).then((nextToken) => {
      setBusy(false);
      if (nextToken === null) {
        setError('auth');
        return;
      }
      setEmail(null);
      setAccessToken(nextToken);
      setToken(nextToken);
      go('/account');
    });
  }

  function submitRegister(nextEmail: string, password: string) {
    setBusy(true);
    void registerAccount(nextEmail, password).then((created) => {
      if (!created) {
        setBusy(false);
        setError('register');
        return;
      }
      void login(nextEmail, password).then((nextToken) => {
        setBusy(false);
        if (nextToken === null) {
          go('/login');
          setError('auth');
          return;
        }
        setEmail(null);
        setAccessToken(nextToken);
        setToken(nextToken);
        go('/account');
      });
    });
  }

  function signOut() {
    const current = token;
    setAccessToken(null);
    setToken(null);
    setEmail(null);
    go('/');
    if (current !== null) void logout(current);
  }

  return (
    <>
      <header>
        <a
          href="/"
          onClick={(event) => {
            event.preventDefault();
            go('/');
          }}
        >
          {projectName}
          <span>✦</span>
        </a>
        <div className="header-actions">
          {% if locales | length > 1 %}
          <LanguageSwitcher />
          {% endif %}
          <button
            type="button"
            onClick={() => {
              go(token === null ? '/login' : '/account');
            }}
          >
            {token === null ? t('auth.signIn') : t('auth.account')}
          </button>
        </div>
      </header>
      {path === '/login' ? (
        <Login
          error={message}
          providers={providers}
          busy={busy}
          onSubmit={submitLogin}
          onNavigate={go}
        />
      ) : path === '/register' ? (
        <Register
          error={message}
          providers={providers}
          busy={busy}
          onSubmit={submitRegister}
          onNavigate={go}
        />
      ) : path === '/account' ? (
        <Account email={email} onSignOut={signOut} />
      ) : (
        <Landing />
      )}
      {path === '/' ? (
        <footer>
          {projectName} · {t('landing.footer')} {author}
        </footer>
      ) : null}
    </>
  );
}

const root = document.getElementById('root');
if (!root) throw new Error('Missing root element');

void initI18n().then(() => {
  createRoot(root).render(
    <StrictMode>
      <I18nextProvider i18n={i18n}>
        <App />
      </I18nextProvider>
    </StrictMode>,
  );
});
